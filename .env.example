# Required in production. /api/ingest only accepts `Authorization: Bearer $CRON_SECRET`.
# Vercel Cron sends it automatically; the GitHub Actions workflow sends it too.
CRON_SECRET=

# Set automatically when you connect a Vercel Blob store to the project.
# Without it, snapshots are stored in .data/bundle.bin (local dev).
BLOB_READ_WRITE_TOKEN=

# Optional: skip the blob head() lookup by giving the public URL of bura/bundle.bin.
BLOB_BUNDLE_URL=
